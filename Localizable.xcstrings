    "opdsPluginIdSyncHint" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The OPDS catalog's ID is used to keep the plugin ID consistent across devices. If the catalog does not provide an ID, this plugin will use a local ID and its records will not sync."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OPDSカタログのIDは、デバイス間でプラグインIDを一致させるために使用されます。カタログにIDがない場合、このプラグインはローカルIDを使用し、その記録は同期されません。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "插件会使用 OPDS 目录提供的 ID，以确保插件 ID 在不同设备上保持一致。如果目录未提供 ID，插件将使用本地 ID，相关记录也不会同步。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "外掛模組會使用 OPDS 目錄提供的 ID，確保在不同裝置間保持一致。若目錄未提供 ID，外掛模組會使用僅限本機的 ID，相關記錄將不會同步。"
          }
        }
      }
    },

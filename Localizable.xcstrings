    "clearIndex" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Clear Index"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "インデックスを消去"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "清除索引"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "清除索引"
          }
        }
      }
    },
    "clearIndexMessage" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The index speeds up browsing. Clearing it will force a rebuild and may temporarily slow things down. Are you sure you want to continue?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "インデックスによりブラウズが高速になります。消去すると再構築が必要になり、一時的に動作が遅くなる場合があります。続けてもよろしいですか？"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "索引可加快浏览速度。清除索引后需要重新构建，可能会暂时降低速度。确定要继续吗？"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "索引可加快瀏覽速度。清除後將需要重新建立，可能會暫時減慢速度。你確定要繼續嗎？"
          }
        }
      }
    },

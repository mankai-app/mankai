    "foldersDescription" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Manage the folders and catalogs available in Browse, including adding new locations, configuring existing ones, removing locations, and more."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ブラウズで使用できるフォルダやカタログを管理します。新しい場所の追加、既存の場所の設定、場所の削除などを行えます。"
          }

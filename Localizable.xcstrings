        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "新しいアクセントカラーを反映するには、アプリの再起動が必要な場合があります。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",

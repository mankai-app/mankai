      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Downsample Images"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "画像をダウンサンプリング"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "降低图片分辨率"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "縮小圖片"
          }
        }
      }
    },
    "downsampleImagesDescription" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reduce decoded image sizes to lower memory usage. Disable this to preserve full image resolution at the cost of higher memory usage."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "デコード後の画像サイズを縮小して、メモリ使用量を抑えます。無効にするとメモリ使用量は増えますが、画像の解像度が維持されます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "降低解码后图片的尺寸以减少内存占用。禁用此功能可保留完整图片分辨率，但会占用更多内存。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "縮小解碼後的圖片尺寸，以降低記憶體用量。停用後會保留完整圖片解析度，但會增加記憶體用量。"
          }
        }
      }
    },
    "downsampleMemorySavings" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Memory Savings"
          }

    "appFsPluginDescription" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This is a built-in plugin that enables users to store and manage manga directly within the app's local directory."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アプリのローカルディレクトリ内に漫画を直接保存し、管理できる内蔵プラグインです。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这是一个内置插件，可让用户直接在 App 的本地目录中存储和管理漫画。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "這是內置外掛模組，讓用戶直接在 App 的本機目錄儲存和管理漫畫。"
          }
        }
      }
    },

    "upscaleSensitivityDescription" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Higher sensitivity applies upscaling to more images, including larger ones. This uses more processing power and memory."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "感度を高くすると、大きな画像を含むより多くの画像がアップスケールされます。処理能力とメモリの使用量も増加します。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "灵敏度越高，越多图片会被放大，包括尺寸较大的图片。这会占用更多计算资源和内存。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "敏感度越高，越多圖片會被放大，包括尺寸較大的圖片。這會使用更多運算資源和記憶體。"
          }
        }
      }

    "smartGrouping" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Smart Grouping"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "スマートグループ化"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "智能分组"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "智能分組"
          }
        }
      }
    },
    "smartGroupingDescription" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Smart grouping uses deep learning to automatically organize pages based on content similarity. Results may vary, and enabling this feature could impact performance and battery life."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "スマートグループ化では、ディープラーニングを使って内容の類似性に基づきページを自動整理します。結果にはばらつきがあり、有効にするとパフォーマンスやバッテリー駆動時間に影響する場合があります。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "智能分组使用深度学习技术，根据内容相似度自动整理页面。结果可能会有所不同，启用此功能也可能影响性能和电池续航。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "智能分組利用深度學習技術，根據內容相似度自動對頁面進行分類。請注意，分組結果可能不盡完美，且可能會影響執行效能和電池續航力。"
          }
        }
      }
    },
    "smartGroupingSensitivity" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Smart Grouping Sensitivity"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "スマートグループ化の感度"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "智能分组灵敏度"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "智能分組敏感度"
          }
        }
      }
    },
    "smartGroupingSensitivityDescription" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Higher sensitivity will tend to group pages together and lower sensitivity will tend to split pages apart."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "感度を高くするとページがまとまりやすくなり、低くすると分かれやすくなります。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "灵敏度越高，页面越容易分到同一组；灵敏度越低，页面越容易分到不同组。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "數值越高，越容易將頁面分在一起。數值越低，越容易將頁面分開。"
          }
        }
      }
    },

    "pluginIdSyncHint" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mankai stores a \".mankai\" file in this folder to keep the plugin ID consistent across devices. If the file cannot be written, this plugin will use a local ID and its records will not sync."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mankaiはこのフォルダに「.mankai」ファイルを保存し、デバイス間でプラグインIDを一致させます。ファイルを書き込めない場合、このプラグインはローカルIDを使用し、その記録は同期されません。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mankai 会在此文件夹中存储“.mankai”文件，以使插件 ID 在不同设备上保持一致。如果无法写入该文件，插件将使用本地 ID，相关记录也不会同步。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mankai 會在此資料夾儲存「.mankai」檔案，讓外掛模組 ID 在不同裝置間保持一致。如果無法寫入此檔案，外掛模組將使用本機 ID，其記錄亦不會同步。"
          }
        }
      }
    },

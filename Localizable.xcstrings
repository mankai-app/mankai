    "clearCacheDirMessage" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This will remove all cached files, including the index cache. Are you sure you want to continue?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "インデックスキャッシュを含むすべてのキャッシュファイルが削除されます。続けてもよろしいですか？"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这将移除所有缓存文件，包括索引缓存。确定要继续吗？"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "這將移除所有快取檔案，包含索引快取。你確定要繼續嗎？"
          }
        }
      }
    },
    "clearCacheMessage" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {

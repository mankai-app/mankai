    "downsampleMemorySavingsDescription" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choose how much memory to save. Higher savings use lower-resolution images."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "メモリをどの程度節約するかを選択します。節約量を増やすと、画像の解像度は低くなります。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "选择要节省的内存量。节省越多，图片分辨率越低。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "選擇要節省的記憶體量。節省越多，圖片解析度越低。"
          }
        }
      }
    },

    "duplicateBrowsablePluginIdMessageFormat" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A plugin with the ID “%@” already exists. You can overwrite it or add the new plugin as a local plugin that does not sync across devices."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ID「%@」のプラグインはすでに存在します。上書きするか、デバイス間で同期されないローカルプラグインとして追加できます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ID 为“%@”的插件已存在。你可以覆盖它，或将新插件添加为不会跨设备同步的本地插件。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ID 為「%@」的外掛模組已存在。你可以覆寫該外掛模組，或將新外掛模組加入為不跨裝置同步的本機外掛模組。"
          }
        }
      }
    },
    "duplicatePluginIdMessageFormat" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A plugin with the ID “%@” already exists. Do you want to overwrite it?"

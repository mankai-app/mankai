    "accentColorDescription" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choose the color used for buttons, links, and other controls throughout the app."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アプリ内のボタン、リンク、その他のコントロールに使用する色を選択します。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "选择 App 中按钮、链接和其他控件所使用的颜色。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "選擇 App 內按鈕、連結及其他控制項使用的顏色。"
          }
        }
      }
    },
    "accentColorRestartNoticeMessage" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You may need to restart the app for the new accent color to take effect."
